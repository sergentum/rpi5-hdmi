a@rpi5:~ $ cat /etc/systemd/system/rpi-input-controller.service
[Unit]
Description=Raspberry Pi Input + CEC + Moonlight Controller
After=graphical.target
Wants=graphical.target

[Service]
Type=simple
User=a
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/a/.Xauthority
WorkingDirectory=/home/a
ExecStart=/usr/bin/python3 /home/a/main.py
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target

